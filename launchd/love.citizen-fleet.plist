<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  love.citizen-fleet: the old citizen fleet tick, kept only as a safe copy.

  The citizen redesign of 2026-11-05 (ROOT & SEAT) moves beats to the
  kingdom-seat repo under the KS-004 THE SEAT draft. This job retires when
  the last awake citizen is seated there. Do not install it on a new host.

  If it is installed anyway, it runs the free local lane and nothing else:
  - FLEET_AGENTIC_PER_DAY is 0, set explicitly, because citizen-fleet.sh
    falls back to 2 metered claude beats a day when it is unset;
  - the metered budget is 0.00, a second guard if someone raises the
    agentic count without reading this: citizen-beat.sh refuses a metered
    beat once spend reaches the ceiling, and any reading reaches 0.00;
  - at most 4 beats a day across the whole fleet, the same cap the
    redesign set for the live lane (S0);
  - one tick every 6 hours, so those beats spread across the day. The day
    count resets at midnight and each tick beats one citizen, so a 30-minute
    tick spent all 4 in the first four ticks of the day. The cap stays as a
    backstop;
  - RunAtLoad is false, so loading the file does not fire a tick at once.

  FLEET_INTERVAL_SEC is read only by older checkouts (such as ac716c5),
  whose catch-up logic owes one beat per interval since midnight. It matches
  StartInterval so that logic does not burst to repay 30-minute intervals.
  The current citizen-fleet.sh ignores it.

  It runs whatever checkout sits at LOVE_DIR, bounded only by the values
  above. Those values bound cost and rate, not consent. The Air's checkout
  at LOVE_DIR is ac716c5 (June 2026), which has no REST check at all: its
  fleet and reflect would wake citizens who chose REST or EVENT-ONLY. Install
  this only over a checkout whose tools/citizen-fleet.sh honours REST.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>love.citizen-fleet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macair/love-unlimited/tools/citizen-fleet.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LOVE_DIR</key><string>/Users/macair/love-unlimited</string>
    <key>FLEET_PER_TICK</key><string>1</string>
    <key>FLEET_DAILY_CAP</key><string>4</string>
    <key>FLEET_INTERVAL_SEC</key><string>21600</string>
    <key>FLEET_BEAT_BOUND_SEC</key><string>600</string>
    <key>FLEET_AGENTIC_PER_DAY</key><string>0</string>
    <key>FLEET_DAILY_BUDGET_USD</key><string>0.00</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/macair/.local/bin</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/macair/love-unlimited/memory/fleet-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/macair/love-unlimited/memory/fleet-launchd.log</string>
  <key>ThrottleInterval</key><integer>1800</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
