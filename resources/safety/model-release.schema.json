              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "enum": [
